# OrionLink deployment configuration.
#
#   cp .env.example .env
#
# This is the ONLY file an evaluator needs to edit to relocate the stack. No
# source file, HTML page, or JSON config carries a service address; everything
# derives from the variables below (Go: internal/config, TCA: rendered into
# /orion-config.js at container start, IdP/Broker pages: /ssso/pubconfig.js).
#
# Every variable has a built-in default matching the values here, so the stack
# also comes up with no .env at all.

# ---------------------------------------------------------------------------
# Container image
# ---------------------------------------------------------------------------
# Locally built image. For the published image use:
# ORION_IMAGE=walnutd/orionlink-ae:ndss2027-v2
ORION_IMAGE=orionlink-ae:ndss2027-v2
ORION_PULL_POLICY=missing

# ---------------------------------------------------------------------------
# Profile
# ---------------------------------------------------------------------------
# demo  — reviewer-facing deployment: styled pages, the few named demo accounts
#         (Alice, Bob), and NO check-bypassing endpoints. Default.
# bench — measurement deployment: decorative rendering suppressed, thousands of
#         synthetic accounts seeded, RP auto-registers, and the load-test
#         endpoints under */test_endpoint.go are mounted.
#
# Both profiles run the same server binary and serve the same pages with the
# same protocol JavaScript. Only presentation and fixtures differ, so the demo
# a reviewer clicks through is the deployment the timings come from.
ORION_PROFILE=demo

# ---------------------------------------------------------------------------
# Container network emulation
# ---------------------------------------------------------------------------
# Every container adds this delay to its outgoing traffic. Communication
# between two shaped containers therefore adds approximately twice this value
# to the network RTT.
ORION_NETEM_DELAY=
ORION_NETEM_JITTER=

# ---------------------------------------------------------------------------
# Browser-facing URLs — what the user's browser and the Playwright suite use.
# ---------------------------------------------------------------------------
ORION_IDP_URL=http://localhost:3000
ORION_BROKER_URL=http://localhost:3001
ORION_RP_URL=http://localhost:3002
# The TCA MUST stay on an origin distinct from the IdP. Co-hosting them
# collapses the isolation the paper's threat model depends on (§3).
ORION_TCA_URL=http://localhost:3003

# ---------------------------------------------------------------------------
# Server-facing URLs — how the services reach each other.
# ---------------------------------------------------------------------------
# Only needed when that differs from the browser view. Under docker compose it
# does: "localhost" inside a container is that container, not the host, so
# compose sets these to the service names. Leave them unset for a bare-metal
# single-host run and each service is reached at its browser URL.
#ORION_IDP_SERVER_URL=http://idp:3000
#ORION_BROKER_SERVER_URL=http://broker:3001
#ORION_RP_SERVER_URL=http://rp:3002

# ---------------------------------------------------------------------------
# Published host ports (docker compose only)
# ---------------------------------------------------------------------------
# Change these together with the URLs above if 3000-3003 are taken.
ORION_IDP_PORT=3000
ORION_BROKER_PORT=3001
ORION_RP_PORT=3002
ORION_TCA_PORT=3003

# Bind address override, for running behind a reverse proxy where the public
# URL has no port (or 443) while the process still listens on 3000.
#ORION_IDP_LISTEN=:3000
#ORION_BROKER_LISTEN=:3001
#ORION_RP_LISTEN=:3002

# ---------------------------------------------------------------------------
# Directories
# ---------------------------------------------------------------------------
# Mutable runtime state: freshly generated keys and RP registrations. Untracked
# by git — a committed copy would embed the authors' addresses and keys, which
# is exactly what breaks on a reviewer's machine. Delete this directory to reset
# a deployment. Defaults to the repository root (compose sets it to /data).
#ORION_DATA_DIR=./data

# Read-only source tree (static pages, default config). Only needed when the
# repository root cannot be discovered by walking up for go.mod — which is the
# case inside the container, where the Dockerfile sets it to /app.
#ORION_ASSET_DIR=.

# ---------------------------------------------------------------------------
# Fixtures and benchmarking
# ---------------------------------------------------------------------------
# Register the RP with IdP and Broker at startup instead of requiring a click on
# the RP's "Register RP" page. Implied by ORION_PROFILE=bench. Left off in demo
# because RP registration is one of the protocol steps worth watching happen.
#ORION_AUTO_REGISTER=1

# Synthetic accounts seeded under the bench profile, so concurrent virtual users
# do not serialise on one identity.
#ORION_BENCH_USERS=1000

# Full logins driven by the browser latency harness (npm run perf).
#ORION_PERF_ITERATIONS=10

# Simulated human interaction in the end-to-end latency harness
# (benchmark/e2/browser/human.ts). The reported end-to-end figure is what a user waits,
# so it includes think and typing time drawn from the keystroke-level model.
# Set to 0 to drive the flow at machine speed instead.
#ORION_HUMAN=0
#ORION_HUMAN_SCALE=1.0    # scale every KLM operator (0.5 = twice as fast a user)
#ORION_HUMAN_SIGMA=0.25   # lognormal jitter; 0 makes the timings deterministic
#ORION_HUMAN_SEED=20260808
